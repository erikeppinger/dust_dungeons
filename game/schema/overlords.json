{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Overlords",
  "description": "game/overlords.toml: the weekly Overlords' parts, colors, traits, names and holidays. See game/README.md.",
  "type": "object",
  "required": [
    "names",
    "titles",
    "parts",
    "eras",
    "schemes",
    "traits",
    "holidays",
    "boons"
  ],
  "additionalProperties": false,
  "properties": {
    "names": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "titles": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "parts": {
      "type": "object",
      "required": [
        "body",
        "face",
        "hat",
        "item",
        "extra",
        "scheme"
      ],
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/keys"
        },
        "face": {
          "$ref": "#/$defs/keys"
        },
        "hat": {
          "$ref": "#/$defs/keys"
        },
        "item": {
          "$ref": "#/$defs/keys"
        },
        "extra": {
          "$ref": "#/$defs/keys"
        },
        "scheme": {
          "$ref": "#/$defs/keys"
        }
      }
    },
    "eras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "body",
          "face",
          "hat",
          "item",
          "extra",
          "scheme",
          "name",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "A Monday, YYYY-MM-DD."
          },
          "body": {
            "$ref": "#/$defs/count"
          },
          "face": {
            "$ref": "#/$defs/count"
          },
          "hat": {
            "$ref": "#/$defs/count"
          },
          "item": {
            "$ref": "#/$defs/count"
          },
          "extra": {
            "$ref": "#/$defs/count"
          },
          "scheme": {
            "$ref": "#/$defs/count"
          },
          "name": {
            "$ref": "#/$defs/count"
          },
          "title": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "schemes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "main",
          "light"
        ],
        "additionalProperties": false,
        "properties": {
          "main": {
            "$ref": "#/$defs/color"
          },
          "light": {
            "$ref": "#/$defs/color",
            "description": "The skin."
          }
        }
      }
    },
    "traits": {
      "type": "object",
      "description": "One per body.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "bpm": {
            "type": "integer",
            "minimum": -20,
            "maximum": 20,
            "description": "Tempo change."
          },
          "beats": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "description": "More beats per rhythm."
          },
          "offbeat": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5,
            "description": "Added chance of a beat between two pulses."
          },
          "eighth": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5,
            "description": "Added chance of an eighth."
          },
          "lanes": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.3,
            "description": "Added chance of notes between beats in the lane phase."
          }
        }
      }
    },
    "holidays": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "setting",
          "name",
          "trophy",
          "hat",
          "item",
          "extra",
          "scheme",
          "boon"
        ],
        "additionalProperties": false,
        "properties": {
          "day": {
            "type": "string",
            "pattern": "^(\\d{2}-\\d{2}|easter|hanukkah)$",
            "description": "MM-DD, easter or hanukkah. Or use dates."
          },
          "setting": {
            "$ref": "#/$defs/text",
            "description": "The holiday, for the settings."
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "trophy": {
            "$ref": "#/$defs/text"
          },
          "hat": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "extra": {
            "type": "string"
          },
          "scheme": {
            "type": "string"
          },
          "dates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "Every date, for holidays that follow the moon."
          },
          "boon": {
            "type": "object",
            "description": "What beating it gives for [boons] days: effects as in items.toml.",
            "additionalProperties": {
              "type": [
                "integer",
                "boolean"
              ]
            }
          }
        }
      }
    },
    "boons": {
      "type": "object",
      "required": [
        "days"
      ],
      "additionalProperties": false,
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "description": "How long a holiday boon lasts."
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": [
        "en",
        "de"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "keys": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "count": {
      "type": "integer",
      "minimum": 3
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
