<?xml version="1.0" encoding="utf-8"?>
<!-- The picture the app drew for today; a short text until there is one. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_picture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_picture_description"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/widget_setup"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />
</FrameLayout>
