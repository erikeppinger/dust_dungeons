  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"color_key\" INTEGER NOT NULL DEFAULT 0, \"created_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"avatar_skin\" INTEGER NOT NULL DEFAULT 0, \"avatar_hair\" INTEGER NOT NULL DEFAULT 0, \"avatar_cape\" INTEGER NOT NULL DEFAULT 0, \"avatar_hat\" INTEGER NOT NULL DEFAULT 0, \"story_mode\" INTEGER NOT NULL DEFAULT 0 CHECK (\"story_mode\" IN (0, 1)), \"slow_mode\" INTEGER NOT NULL DEFAULT 0 CHECK (\"slow_mode\" IN (0, 1)), \"archived_at\" TEXT NULL, \"curse_family\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "chores",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chores\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"seed_key\" TEXT NULL UNIQUE, \"custom_title\" TEXT NULL, \"icon_key\" TEXT NOT NULL, \"color_key\" INTEGER NOT NULL, \"base_points\" INTEGER NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"repeat_type\" TEXT NOT NULL DEFAULT 'anytime', \"repeat_interval\" INTEGER NOT NULL DEFAULT 1, \"repeat_weekdays\" INTEGER NOT NULL DEFAULT 0, \"repeat_day_of_month\" INTEGER NULL, \"repeat_start\" TEXT NULL, \"repeat_set_at\" TEXT NULL, \"reminder_minutes\" INTEGER NULL, \"boss_family\" TEXT NULL, \"repeat_month_week\" INTEGER NULL, \"window_days\" INTEGER NOT NULL DEFAULT 1, \"window_from\" INTEGER NULL, \"window_to\" INTEGER NULL, \"assignment\" TEXT NOT NULL DEFAULT 'anyone');"
        }
      ]
    },
    {
      "name": "completions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"completions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"chore_id\" INTEGER NOT NULL REFERENCES chores (id), \"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"completed_at\" TEXT NOT NULL, \"points_awarded\" INTEGER NOT NULL, \"undone_at\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "point_ledger",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"point_ledger\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"delta\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"completion_id\" INTEGER NULL REFERENCES completions (id), \"created_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "fights",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"fights\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"family\" TEXT NOT NULL, \"tier\" INTEGER NOT NULL, \"story_mode\" INTEGER NOT NULL DEFAULT 0 CHECK (\"story_mode\" IN (0, 1)), \"started_at\" TEXT NOT NULL, \"ended_at\" TEXT NULL, \"result\" TEXT NULL, \"perfect\" INTEGER NOT NULL DEFAULT 0, \"good\" INTEGER NOT NULL DEFAULT 0, \"miss\" INTEGER NOT NULL DEFAULT 0, \"loot\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "inventory",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inventory\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"item_key\" TEXT NOT NULL, \"count\" INTEGER NOT NULL, PRIMARY KEY (\"profile_id\", \"item_key\"));"
        }
      ]
    },
    {
      "name": "screen_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"screen_days\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"day\" TEXT NOT NULL, \"used_minutes\" INTEGER NOT NULL DEFAULT 0, \"budget_minutes\" INTEGER NOT NULL DEFAULT 0, \"voucher_minutes\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"profile_id\", \"day\"));"
        }
      ]
    },
    {
      "name": "chore_assignees",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chore_assignees\" (\"chore_id\" INTEGER NOT NULL REFERENCES chores (id), \"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), PRIMARY KEY (\"chore_id\", \"profile_id\"));"
        }
      ]
    },
    {
      "name": "equipped",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"equipped\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"slot\" TEXT NOT NULL, \"item_key\" TEXT NOT NULL, PRIMARY KEY (\"profile_id\", \"slot\"));"
        }
      ]
