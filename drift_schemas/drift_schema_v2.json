  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"color_key\" INTEGER NOT NULL DEFAULT 0, \"created_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP));"
        }
      ]
    },
    {
      "name": "chores",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chores\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"seed_key\" TEXT NULL UNIQUE, \"custom_title\" TEXT NULL, \"icon_key\" TEXT NOT NULL, \"color_key\" INTEGER NOT NULL, \"base_points\" INTEGER NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"repeat_type\" TEXT NOT NULL DEFAULT 'anytime', \"repeat_interval\" INTEGER NOT NULL DEFAULT 1, \"repeat_weekdays\" INTEGER NOT NULL DEFAULT 0, \"repeat_day_of_month\" INTEGER NULL, \"repeat_start\" TEXT NULL, \"repeat_set_at\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "completions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"completions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"chore_id\" INTEGER NOT NULL REFERENCES chores (id), \"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"completed_at\" TEXT NOT NULL, \"points_awarded\" INTEGER NOT NULL, \"undone_at\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "point_ledger",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"point_ledger\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), \"delta\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"completion_id\" INTEGER NULL REFERENCES completions (id), \"created_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
